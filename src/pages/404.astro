---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — TundeCodes"
  description="The requested page could not be found."
>
  <section class="page-hero section-shell reveal not-found">
    <p class="section-number">404 / TRACE LOST</p>
    <h1>This route does not resolve.</h1>
    <p>The page may have moved, been removed, or never existed. Return to the main trace and continue from there.</p>
    <div class="hero-links">
      <a class="primary-link" href="/">Back home <span>↗</span></a>
      <a class="plain-link" href="/work">View work ↗</a>
    </div>
  </section>
</BaseLayout>
